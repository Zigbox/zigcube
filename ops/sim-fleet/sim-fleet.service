[Unit]
Description=Zigcube simulation fleet (sim-cluster on fresh seeds at the tip of main)
Documentation=https://github.com/Zigbox/zigcube/blob/main/ops/sim-fleet/README.md
After=network-online.target
Wants=network-online.target

[Service]
User=simfleet
Group=simfleet
WorkingDirectory=/var/lib/sim-fleet
EnvironmentFile=-/etc/sim-fleet/fleet.env
# systemd reads the token as root and hands the service a private copy under
# $CREDENTIALS_DIRECTORY; the service user cannot read /etc/sim-fleet/token itself.
LoadCredential=token:/etc/sim-fleet/token
ExecStart=/var/lib/sim-fleet/zigcube/ops/sim-fleet/run.sh
Restart=always
RestartSec=30
Nice=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sim-fleet
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
