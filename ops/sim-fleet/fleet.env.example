# /etc/sim-fleet/fleet.env: settings of the simulation fleet. Every line is optional.
# The token is not here: it is the file /etc/sim-fleet/token (README.md).

# The issue that gets one comment per finished UTC day with the seeds run and the failures by
# issue. Zigbox/zigcube's is #29. Without it the daily totals are counted but not posted.
SIM_FLEET_TRACKER=29

# Seeds per batch and operations per seed. Sized for 4 vCPU, 8 GB, 160 GB. SIM_FLEET_BATCH is
# the default of sim-cluster and sim-c1 (a seed takes about a second); each kind can be set
# alone with SIM_FLEET_BATCH_CLUSTER, _C1 and _SWARM. The swarm's default is 50000 (a seed takes
# about 1.5 ms) and does not follow SIM_FLEET_BATCH; set SIM_FLEET_BATCH_SWARM to change it.
SIM_FLEET_BATCH=100
# auto: each run's size, shape and fault profile are drawn from its seed (the point of the fleet).
# A number fixes the operations; SIM_FLEET_PROFILE=mixed|partitions|... fixes the profile.
# A host installed before the draw still has SIM_FLEET_OPS=100 here (setup.sh never overwrites
# this file): change it to auto, or delete the line.
SIM_FLEET_OPS=auto
SIM_FLEET_PROFILE=auto
# Parallel workers per kind (one core each): sim_cluster, sim_cluster --c1 and sim_swarm. 1 + 1 + 1
# leaves a core of a 4 vCPU host for the reporter and builds; 0 stops a kind. (The first release's
# SIM_FLEET_WORKERS is ignored.)
SIM_FLEET_WORKERS_CLUSTER=1
SIM_FLEET_WORKERS_C1=1
SIM_FLEET_WORKERS_SWARM=1
# The build caches (.zig-cache, zig-pkg, ~/.cache/zig) are emptied before a build when together
# they pass this many MB.
SIM_FLEET_CACHE_MB=8192

# The teeth canary: 1 round in this many also runs the next fault-on runner of the cycle, which
# must fail (README.md, item 4); 0 never, 1 every round. A number, or run.sh refuses to start.
SIM_FLEET_CANARY_ONE_IN=50
# Coverage feedback: 1 round in this many runs each cluster kind on the profile that most often
# reaches what the fewest seeds of this commit reach (README.md, item 6), when SIM_FLEET_PROFILE
# is auto; 0 never. A number, or run.sh refuses to start.
SIM_FLEET_BIAS_ONE_IN=2
# A canary GitHub held back, or the host kept from running, runs again next round, this many
# times in a row at most.
SIM_FLEET_CANARY_TRIES_MAX=5

# Deadlines in seconds: git, a build, one producer batch, one sim_fleet ingest.
SIM_FLEET_GIT_TIMEOUT=300
SIM_FLEET_BUILD_TIMEOUT=3600
SIM_FLEET_BATCH_TIMEOUT=3600
SIM_FLEET_REPORT_TIMEOUT=600

# Leave empty in this file. A dry run (README.md) sets it on its own command line: it then uses
# its own checkout and state under /var/lib/sim-fleet/dry and files nothing.
SIM_FLEET_DRY_RUN=
