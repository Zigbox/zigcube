# /etc/sim-fleet/fleet.env: settings of the simulation fleet. Every line is optional.
# The token is not here: it is the file /etc/sim-fleet/token (README.md).

# The issue that gets one comment per finished UTC day with the seeds run. Create it by hand
# ("Simulation fleet: seeds per day"), pin it, and put its number here. Without it the daily
# totals are counted but not posted.
SIM_FLEET_TRACKER=

# Seeds per batch and operations per seed. Sized for 4 vCPU, 8 GB, 160 GB.
SIM_FLEET_BATCH=100
SIM_FLEET_OPS=100
# Parallel sim_cluster runs (one core each); 3 leaves a core for the reporter and builds.
SIM_FLEET_WORKERS=3
# .zig-cache is emptied before a build when it passes this many MB.
SIM_FLEET_CACHE_MB=8192

# Anything non-empty: print what would be filed and file nothing (no token needed).
SIM_FLEET_DRY_RUN=
