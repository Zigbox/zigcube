// zcube-server's configuration (zcube-server --help lists every field). A change takes effect
// when the service restarts: systemctl restart zcube-server
.{
    // The server's writes are unauthenticated: listen on a loopback or private address.
    .listen = "127.0.0.1:7070",
    .store = "sqlite:/var/lib/zigcube/server.db",
    .create_store = true,
}
