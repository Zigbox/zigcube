[Unit]
Description=Zigcube node agent
Documentation=https://zigbox.github.io/zigcube/
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/zigcube/agent.zon

[Service]
Type=simple
# The node's name is the host's short name; edit /etc/zigcube/agent.zon first (what the node
# offers is declared there). Stopping the agent leaves containers running: a restart adopts them.
ExecStart=/usr/bin/zcube-agent --config /etc/zigcube/agent.zon --node %l
Restart=on-failure
RestartSec=2
KillMode=process

[Install]
WantedBy=multi-user.target
