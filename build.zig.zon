        // lifecycle (list, adopt, stop), image runs, pull as a library call, limits and exit reasons.
        .zigbox = .{
            .url = "https://github.com/Zigbox/zigbox/archive/5a853fd7f80fdabb4a8b6c8c76751532fd676e2e.tar.gz",
