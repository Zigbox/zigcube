--- /dev/null
+++ b/.github/check-zigcube-asset-test.sh
@@ -0,0 +1,155 @@
+#!/usr/bin/env bash
+# Table test of check-zigcube-asset.sh: builds small assets and checks each is accepted or
+# refused as it should be. Needs bash, tar, gzip, coreutils. Run: bash .github/check-zigcube-asset-test.sh
+set -euo pipefail
+
+here=$(cd "$(dirname "$0")" && pwd)
+check="$here/check-zigcube-asset.sh"
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+failed=0
+
+# The files a signed Zigcube asset holds (two architectures), as release-sign.sh writes them.
+good_files=(
+  apt/dists/zigcube/Release apt/dists/zigcube/InRelease apt/dists/zigcube/Release.gpg
+  apt/dists/zigcube/main/binary-amd64/Packages apt/dists/zigcube/main/binary-amd64/Packages.gz
+  apt/pool/main/z/zigcube/zigcube_0.5.1_amd64.deb
+  apt/pool/main/z/zigcube-server-sqlite/zigcube-server-sqlite_0.5.1_amd64.deb
+  apt/pool/main/z/zigbox-dev/zigbox-dev_0.5.1_amd64.deb
+  rpm/zigcube/x86_64/repodata/repomd.xml rpm/zigcube/x86_64/repodata/repomd.xml.asc
+  rpm/zigcube/x86_64/zigcube-0.5.1-1.x86_64.rpm
+  rpm/zigcube/aarch64/repodata/repomd.xml rpm/zigcube/aarch64/repodata/repomd.xml.asc
+)
+# Zigbox's asset, as the first fetch step lists it (directories with a trailing slash).
+cat > "$work/zigbox.list" <<'EOF'
+apt/
+apt/dists/
+apt/dists/stable/
+apt/dists/stable/Release
+apt/dists/stable/InRelease
+apt/pool/
+apt/pool/main/
+apt/pool/main/z/
+apt/pool/main/z/zigbox/
+apt/pool/main/z/zigbox/zigbox_0.5.1_amd64.deb
+rpm/
+rpm/x86_64/
+rpm/x86_64/repodata/repomd.xml
+zigbox-archive-keyring.gpg
+zigbox-archive-keyring.asc
+EOF
+
+# make_asset NAME [extra command...]: a directory with the good files, then the extra command run
+# in it, then tarred like release-sign.sh does (tar -czf ... -C dir apt rpm [more]).
+make_asset() {
+  local name=$1
+  shift
+  local dir="$work/$name.d"
+  mkdir -p "$dir"
+  for f in "${good_files[@]}"; do
+    mkdir -p "$dir/$(dirname "$f")"
+    printf '%s\n' "$f" > "$dir/$f"
+  done
+  if [ "$#" -gt 0 ]; then (cd "$dir" && "$@"); fi
+  local tops
+  tops=$(cd "$dir" && ls -A)
+  # shellcheck disable=SC2086
+  tar -czf "$work/$name.tar.gz" -C "$dir" $tops
+}
+
+# expect NAME accept|refuse TEXT [ZIGBOX_LIST]: TEXT must appear in the output of a refusal.
+expect() {
+  local name=$1 want=$2 text=$3 list=${4:-$work/zigbox.list}
+  local out status=0
+  out=$(bash "$check" "$work/$name.tar.gz" "$list" "$work/$name.tree" 2>&1) || status=$?
+  if [ "$want" = accept ]; then
+    if [ "$status" != 0 ] || [ ! -s "$work/$name.tree.manifest" ]; then
+      echo "FAIL $name: refused: $out"; failed=1; return
+    fi
+    if ! (cd "$work/$name.tree" && sha256sum --quiet -c "$work/$name.tree.manifest"); then
+      echo "FAIL $name: manifest does not match the tree"; failed=1; return
+    fi
+    echo "ok   $name: accepted, $(wc -l < "$work/$name.tree.manifest") files"
+  else
+    if [ "$status" != 1 ]; then echo "FAIL $name: exit $status, want 1: $out"; failed=1; return; fi
+    if [ -e "$work/$name.tree" ]; then echo "FAIL $name: refused but unpacked"; failed=1; return; fi
+    if ! grep -qF -- "$text" <<< "$out"; then
+      echo "FAIL $name: no '$text' in: $out"; failed=1; return
+    fi
+    echo "ok   $name: refused: $(tail -n 1 <<< "$out")"
+  fi
+}
+
+make_asset good
+expect good accept ""
+
+make_asset stable_suite sh -c 'mkdir -p apt/dists/stable && echo x > apt/dists/stable/Release'
+expect stable_suite refuse "outside Zigcube's suite"
+
+make_asset zigbox_pool sh -c 'mkdir -p apt/pool/main/z/zigbox && echo x > apt/pool/main/z/zigbox/zigbox_0.5.1_amd64.deb'
+expect zigbox_pool refuse "outside Zigcube's suite"
+
+make_asset zigbox_rpm sh -c 'mkdir -p rpm/x86_64 && echo x > rpm/x86_64/zigbox-0.5.1-1.x86_64.rpm'
+expect zigbox_rpm refuse "outside Zigcube's suite"
+
+make_asset keyring sh -c 'echo x > zigbox-archive-keyring.gpg'
+expect keyring refuse "zigbox.org must not serve"
+
+make_asset keyring_in_suite sh -c 'echo x > apt/dists/zigcube/zigbox-archive-keyring.asc'
+expect keyring_in_suite refuse "zigbox.org must not serve"
+
+make_asset dotfile sh -c 'echo x > apt/dists/zigcube/.htaccess'
+expect dotfile refuse "zigbox.org must not serve"
+
+make_asset html sh -c 'echo x > rpm/zigcube/index.html'
+expect html refuse "zigbox.org must not serve"
+
+make_asset to_sign sh -c 'mkdir -p rpm/zigcube/to-sign && echo x > rpm/zigcube/to-sign/a.header'
+expect to_sign refuse "zigbox.org must not serve"
+
+make_asset test_key sh -c 'echo x > apt/dists/zigcube/zigbox-test-key.gpg'
+expect test_key refuse "zigbox.org must not serve"
+
+make_asset symlink ln -s Release apt/dists/zigcube/Link
+expect symlink refuse "other than files and directories"
+
+# zigcube* is a prefix (zigcube-agent, zigcube-server-*); zigbox-dev is one exact directory.
+make_asset zigcube_prefix sh -c 'mkdir -p apt/pool/main/z/zigcube-agent && echo x > apt/pool/main/z/zigcube-agent/a.deb'
+expect zigcube_prefix accept ""
+
+make_asset dev_prefix sh -c 'mkdir -p apt/pool/main/z/zigbox-devil && echo x > apt/pool/main/z/zigbox-devil/a.deb'
+expect dev_prefix refuse "outside Zigcube's suite"
+
+make_asset file_in_dir_path sh -c 'echo x > apt/pool/main/z/a.deb'
+expect file_in_dir_path refuse "outside Zigcube's suite"
+
+make_asset suite_prefix sh -c 'mkdir -p apt/dists/zigcubex && echo x > apt/dists/zigcubex/Release'
+expect suite_prefix refuse "outside Zigcube's suite"
+
+make_asset no_inrelease rm apt/dists/zigcube/InRelease
+expect no_inrelease refuse "apt/dists/zigcube/InRelease is missing"
+
+make_asset no_aarch64 rm -r rpm/zigcube/aarch64
+expect no_aarch64 refuse "rpm/zigcube/aarch64/repodata/repomd.xml is missing"
+
+# Zigbox's asset holding one of Zigcube's paths: refused, whichever side added it.
+cp "$work/zigbox.list" "$work/overlap.list"
+echo apt/pool/main/z/zigbox-dev/zigbox-dev_0.5.1_amd64.deb >> "$work/overlap.list"
+make_asset overlap_file
+expect overlap_file refuse "Zigbox's asset holds the paths above too" "$work/overlap.list"
+
+cp "$work/zigbox.list" "$work/overlap_dir.list"
+printf 'rpm/zigcube/\nrpm/zigcube/x86_64/other.rpm\n' >> "$work/overlap_dir.list"
+make_asset overlap_dir
+expect overlap_dir refuse "Zigbox's asset holds the paths above too" "$work/overlap_dir.list"
+
+# A tar listing with ./ prefixes (tar -C dir .) is read the same way.
+make_asset dot_prefix
+tar -czf "$work/dot_prefix.tar.gz" -C "$work/dot_prefix.d" .
+expect dot_prefix accept ""
+
+if [ "$failed" != 0 ]; then
+  echo "check-zigcube-asset-test: FAIL"
+  exit 1
+fi
+echo "check-zigcube-asset-test: PASS"
