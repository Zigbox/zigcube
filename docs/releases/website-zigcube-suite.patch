@@ -0,0 +1,89 @@
+#!/usr/bin/env bash
+# Checks Zigcube's zigcube-repos.tar.gz and unpacks it, for deploy.yml's second fetch step.
+#
+#   check-zigcube-asset.sh ASSET ZIGBOX_LIST TREE
+#
+# ASSET is the downloaded zigcube-repos.tar.gz; ZIGBOX_LIST the paths of Zigbox's asset, one per
+# line, as the first fetch step lists them (pkg/list); TREE an absent directory to unpack into.
+# On success it writes TREE.manifest ("sha256  path" per file, the format of pkg/manifest) and
+# exits 0; on a refusal it prints one line per reason and exits 1, having unpacked nothing.
+#
+# Zigcube's asset may hold only its own suite and rpm tree (Zigcube's
+# docs/decisions/2026-11-14-zigcube-packages.md): files under apt/dists/zigcube/,
+# apt/pool/main/z/zigcube*/, apt/pool/main/z/zigbox-dev/ and rpm/zigcube/, and the directories
+# leading to them. No keyring (the keyring is Zigbox's asset's), no dot file, no .html, never the
+# test key or the to-sign list, and no path Zigbox's asset also holds.
+set -euo pipefail
+
+if [ "$#" -ne 3 ]; then
+  echo "usage: check-zigcube-asset.sh ASSET ZIGBOX_LIST TREE" >&2
+  exit 2
+fi
+asset=$1
+zigbox_list=$2
+tree=$3
+name=$(basename "$asset")
+if [ -e "$tree" ]; then
+  echo "packages: $tree exists already"
+  exit 2
+fi
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+
+tar -tvzf "$asset" | awk '{ print substr($1, 1, 1) }' | sort -u > "$work/kinds"
+if grep -qvx -e - -e d "$work/kinds"; then
+  echo "packages: $name holds something other than files and directories"
+  exit 1
+fi
+tar -tzf "$asset" | sed 's|^\./||' | grep -v '^$' > "$work/list" || true
+if [ ! -s "$work/list" ]; then
+  echo "packages: $name is empty"
+  exit 1
+fi
+# Files under the four subtrees; the directories above them only as directories.
+ok='^(apt/dists/zigcube/|apt/pool/main/z/zigcube[^/]*/|apt/pool/main/z/zigbox-dev/|rpm/zigcube/)'
+dirs='^(apt|apt/dists|apt/pool|apt/pool/main|apt/pool/main/z|rpm)/$'
+refused=0
+if grep -vE "$ok" "$work/list" | grep -vE "$dirs"; then
+  echo "packages: $name holds the paths above, outside Zigcube's suite and rpm tree"
+  refused=1
+fi
+if grep -E '(^|/)\.|\.html?$|to-sign|zigbox-test-key|zigbox-archive-keyring' "$work/list"; then
+  echo "packages: $name holds the paths above, which zigbox.org must not serve"
+  refused=1
+fi
+# A path both assets hold would be served from one and overwrite the other. Directories are
+# shared (apt/, apt/pool/main/z/); a file or a subtree of the other's is not.
+sed 's|^\./||; s|/$||' "$zigbox_list" | grep -v '^$' | sort -u > "$work/zigbox"
+grep -v '/$' "$work/list" | sort -u > "$work/files"
+comm -12 "$work/files" "$work/zigbox" > "$work/both"
+grep -E '^(apt/dists/zigcube|apt/pool/main/z/zigcube[^/]*|apt/pool/main/z/zigbox-dev|rpm/zigcube)(/|$)' \
+  "$work/zigbox" >> "$work/both" || true
+if [ -s "$work/both" ]; then
+  sort -u "$work/both"
+  echo "packages: Zigbox's asset holds the paths above too, so neither is deployed"
+  refused=1
+fi
+if [ "$refused" != 0 ]; then
+  exit 1
+fi
+
+mkdir -p "$work/tree"
+tar -xzf "$asset" -C "$work/tree" --no-same-owner --no-same-permissions
+for f in apt/dists/zigcube/Release apt/dists/zigcube/InRelease apt/dists/zigcube/Release.gpg \
+  rpm/zigcube/x86_64/repodata/repomd.xml rpm/zigcube/x86_64/repodata/repomd.xml.asc \
+  rpm/zigcube/aarch64/repodata/repomd.xml rpm/zigcube/aarch64/repodata/repomd.xml.asc; do
+  if [ ! -s "$work/tree/$f" ]; then
+    echo "packages: $f is missing from $name"
+    exit 1
+  fi
+done
+# Workers static assets refuse a file over 25 MiB.
+big=$(find "$work/tree" -type f -size +25M)
+if [ -n "$big" ]; then
+  echo "packages: over 25 MiB, which the Worker cannot serve: $big"
+  exit 1
+fi
+(cd "$work/tree" && find . -type f | sed 's|^\./||' | sort | xargs sha256sum) > "$work/manifest"
+mv "$work/tree" "$tree"
+mv "$work/manifest" "$tree.manifest"
