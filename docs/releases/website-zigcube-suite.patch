+          fi
+          mkdir pkg/cube
+          gh release download "$tag" --repo Zigbox/zigcube --pattern "$ASSET" --dir pkg/cube
+          # Only Zigcube's own paths, nothing Zigbox's asset holds, and the same refusals as above
+          # (self/.github/check-zigcube-asset.sh; its test is check-zigcube-asset-test.sh).
+          bash self/.github/check-zigcube-asset.sh "pkg/cube/$ASSET" pkg/list pkg/cube/tree \
+            || { echo "packages: $ASSET of Zigcube $tag refused"; exit 1; }
+          cat pkg/cube/tree.manifest >> pkg/manifest
+          echo "packages: $(wc -l < pkg/cube/tree.manifest) files from $ASSET of Zigcube $tag"
       - name: Assemble the site
         run: |
           set -eu
@@ -112,6 +144,13 @@ jobs:
             done
             cp -R pkg/tree/. "$out/"
           fi
+          if [ -d pkg/cube/tree ]; then
+            # Neither src/ nor Zigbox's asset may hold a file of Zigcube's.
+            while read -r _ path; do
+              test ! -e "$out/$path" || { echo "not deployed: $path exists twice"; exit 1; }
+            done < pkg/cube/tree.manifest
+            cp -R pkg/cube/tree/. "$out/"
+          fi
           echo "box:  $(ls "$out/errors/box" | wc -l) error pages and the project site, Zigbox $(git -C box rev-parse --short HEAD)"
           echo "cube: $(ls "$out/errors/cube" | wc -l) error pages and the project site, Zigcube $(git -C cube rev-parse --short HEAD)"
           for f in index.html errors/index.html errors/box/E0101.html errors/cube/E0101.html \
